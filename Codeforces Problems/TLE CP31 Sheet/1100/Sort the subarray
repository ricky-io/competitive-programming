#include <bits/stdc++.h>
using namespace std;

#define int long long
const int MOD = 1e9 + 7;

signed main() {
    int t;
    cin >> t;
    
    while(t--){
        int n;
        cin >> n;

        vector<int> a(n), b(n);
        for(int i=0; i<n; i++) cin >> a[i];
        for(int i=0; i<n; i++) cin >> b[i];

        int l = -1;
        int r = -1;

        int i=0;

        while(a[i] == b[i]){
            i++;
        }
        l = i;
        int j = n-1;
        while(a[j] == b[j]){
            j--;
        }
        r = j;

        cout << l+1 << ' ' << r+1 << '\n';
         
    } 
    return 0;
}
